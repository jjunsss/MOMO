# Optional cloud/provider settings. Set these only when explicitly needed.
OPENAI_API_KEY=

# MOMO local runtime overrides.
MOMO_LLM_PROVIDER=ollama
MOMO_LLM_MODEL=qwen3.5:9b
MOMO_LLM_BASE_URL=http://localhost:11434
MOMO_LLM_NUM_CTX=65536
MOMO_ASR_DEVICE=cuda
MOMO_GUI_PORT=8501
MOMO_MANAGE_OLLAMA=auto
OLLAMA_KEEP_ALIVE=1m
TORCH_INDEX_URL=https://download.pytorch.org/whl/cu124

# Docker Compose deployment overrides.
MOMO_OLLAMA_PORT=11434
MOMO_DOCKER_GPUS=all
MOMO_UID=1000
MOMO_GID=1000
OLLAMA_IMAGE=ollama/ollama:latest
